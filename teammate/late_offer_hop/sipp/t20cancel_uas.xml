<?xml version="1.0" encoding="ISO-8859-1" ?>
<!DOCTYPE scenario SYSTEM "sipp.dtd">
<scenario name="T-20 cancel UAS: 180 to the re-INVITE, 200 to CANCEL, 487">
  <recv request="INVITE" rrs="true">
    <action>
      <ereg regexp="o=[^\r\n]+" search_in="body" check_it="true" assign_to="o_1"/>
      <ereg regexp="m=audio [0-9]+ RTP/AVP [0-9 ]+" search_in="body" check_it="true" assign_to="m_1"/>
      <log message="INVITE offer at UAS [$o_1] [$m_1]"/>
      <ereg regexp=";tag=([^;>]+)" search_in="hdr" header="From:" check_it="true" assign_to="ftag_all,pbx_tag"/>
      <log message="PBX tag [$pbx_tag] [$ftag_all]"/>
    </action>
  </recv>
  <send>
    <![CDATA[
      SIP/2.0 180 Ringing
      [last_Via:]
      [last_From:]
      [last_To:];tag=[pid]SIPpTag01[call_number]
      [last_Call-ID:]
      [last_CSeq:]
      [last_Record-Route:]
      Contact: <sip:karoo@[local_ip]:[local_port];transport=[transport]>
      Content-Length: 0

    ]]>
  </send>
  <send retrans="500">
    <![CDATA[
      SIP/2.0 200 OK
      [last_Via:]
      [last_From:]
      [last_To:];tag=[pid]SIPpTag01[call_number]
      [last_Call-ID:]
      [last_CSeq:]
      [last_Record-Route:]
      Contact: <sip:karoo@[local_ip]:[local_port];transport=[transport]>
      Content-Type: application/sdp
      Content-Length: [len]

      v=0
      o=mediant 2001 1 IN IP4 [media_ip]
      s=-
      c=IN IP4 [media_ip]
      t=0 0
      m=audio [rtpstream_audio_port] RTP/AVP 0 101
      a=rtpmap:0 PCMU/8000
      a=rtpmap:101 telephone-event/8000
      a=fmtp:101 0-15
      a=sendrecv

    ]]>
  </send>
  <recv request="ACK" crlf="true"/>
  <nop>
    <action>
      <exec rtp_stream="tone_pcmu.wav,-1,0"/>
    </action>
  </nop>
  <recv request="INVITE">
    <action>
      <ereg regexp="m=audio [0-9]+ RTP/AVP [0-9 ]+|Content-Length: *0" search_in="msg" check_it="true" assign_to="UAC re-INVITE at UAS_m"/>
      <log message="UAC re-INVITE at UAS [$UAC re-INVITE at UAS_m]"/>
      <ereg regexp=".*" search_in="hdr" header="Via:" check_it="true" assign_to="cvia"/>
      <ereg regexp=".*" search_in="hdr" header="From:" check_it="true" assign_to="cfrom"/>
      <ereg regexp=".*" search_in="hdr" header="To:" check_it="true" assign_to="cto"/>
      <log message="captured [$cvia] [$cfrom] [$cto]"/>
    </action>
  </recv>
  <send>
    <![CDATA[
      SIP/2.0 180 Ringing
      [last_Via:]
      [last_From:]
      [last_To:]
      [last_Call-ID:]
      [last_CSeq:]
      Contact: <sip:karoo@[local_ip]:[local_port];transport=[transport]>
      Content-Length: 0

    ]]>
  </send>
  <recv request="CANCEL">
    <action>
      <ereg regexp="m=audio [0-9]+ RTP/AVP [0-9 ]+|Content-Length: *0" search_in="msg" check_it="true" assign_to="CANCEL at UAS_m"/>
      <log message="CANCEL at UAS [$CANCEL at UAS_m]"/>
    </action>
  </recv>
  <send>
    <![CDATA[
      SIP/2.0 200 OK
      [last_Via:]
      [last_From:]
      [last_To:]
      [last_Call-ID:]
      [last_CSeq:]
      Contact: <sip:karoo@[local_ip]:[local_port];transport=[transport]>
      Content-Length: 0

    ]]>
  </send>
  <send>
    <![CDATA[
      SIP/2.0 487 Request Terminated
      Via: [$cvia]
      From: [$cfrom]
      To: [$cto]
      [last_Call-ID:]
      CSeq: 2 INVITE
      Contact: <sip:karoo@[local_ip]:[local_port];transport=[transport]>
      Content-Length: 0

    ]]>
  </send>
  <recv request="ACK"/>
  <recv request="BYE"/>
  <send>
    <![CDATA[
      SIP/2.0 200 OK
      [last_Via:]
      [last_From:]
      [last_To:]
      [last_Call-ID:]
      [last_CSeq:]
      Contact: <sip:karoo@[local_ip]:[local_port];transport=[transport]>
      Content-Length: 0

    ]]>
  </send>
</scenario>
