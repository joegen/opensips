<?xml version="1.0" encoding="ISO-8859-1" ?>
<!DOCTYPE scenario SYSTEM "sipp.dtd">
<scenario name="T-11 UAS (downack): logs whether the ACK carries a body (fixture-scripted reaction: continue, then BYE from the UAC)">
  <recv request="INVITE" rrs="true">
    <action>
      <ereg regexp="m=audio [0-9]+ RTP/AVP [0-9 ]+" search_in="body" check_it="true" assign_to="inv_m"/>
      <log message="INVITE offer [$inv_m]"/>
    </action>
  </recv>
  <send>
    <![CDATA[
      SIP/2.0 180 Ringing
      [last_Via:]
      [last_From:]
      [last_To:];tag=[pid]SIPpTag01[call_number]
      [last_Call-ID:]
      [last_CSeq:]
      [last_Record-Route:]
      Contact: <sip:karoo@[local_ip]:[local_port];transport=[transport]>
      Content-Length: 0

    ]]>
  </send>
  <send retrans="500">
    <![CDATA[
      SIP/2.0 200 OK
      [last_Via:]
      [last_From:]
      [last_To:];tag=[pid]SIPpTag01[call_number]
      [last_Call-ID:]
      [last_CSeq:]
      [last_Record-Route:]
      Contact: <sip:karoo@[local_ip]:[local_port];transport=[transport]>
      Content-Type: application/sdp
      Content-Length: [len]

      v=0
      o=mediant 2001 1 IN IP4 [media_ip]
      s=-
      c=IN IP4 [media_ip]
      t=0 0
      m=audio [rtpstream_audio_port] RTP/AVP 0 101
      a=rtpmap:0 PCMU/8000
      a=rtpmap:101 telephone-event/8000
      a=fmtp:101 0-15
      a=sendrecv

    ]]>
  </send>
  <recv request="ACK" crlf="true"/>
  <nop>
    <action>
      <exec rtp_stream="tone_pcmu.wav,-1,0"/>
    </action>
  </nop>
  <recv request="INVITE">
    <action>
      <ereg regexp=".*" search_in="hdr" header="Via:" check_it="true" assign_to="rvia"/>
      <log message="re-INVITE Via [$rvia]"/>
    </action>
  </recv>
  <send retrans="500">
    <![CDATA[
      SIP/2.0 200 OK
      [last_Via:]
      [last_From:]
      [last_To:]
      [last_Call-ID:]
      [last_CSeq:]
      [last_Record-Route:]
      Contact: <sip:karoo@[local_ip]:[local_port];transport=[transport]>
      Content-Type: application/sdp
      Content-Length: [len]

      v=0
      o=mediant 2001 2 IN IP4 [media_ip]
      s=-
      c=IN IP4 [media_ip]
      t=0 0
      m=audio [rtpstream_audio_port] RTP/AVP 0 101
      a=rtpmap:0 PCMU/8000
      a=rtpmap:101 telephone-event/8000
      a=fmtp:101 0-15
      a=sendrecv

    ]]>
  </send>
  <recv request="ACK">
    <action>
      <ereg regexp="Content-Length: *[0-9]+" search_in="msg" check_it="true" assign_to="clack"/>
      <ereg regexp="CSeq: *[0-9]+ ACK" search_in="msg" check_it="true" assign_to="csack"/>
      <log message="re-INVITE ACK at UAS: [$csack] [$clack]"/>
    </action>
  </recv>
  <recv request="ACK" optional="true">
    <action>
      <ereg regexp="CSeq: *[0-9]+ ACK" search_in="msg" check_it="true" assign_to="cs0"/>
      <ereg regexp="Content-Length: *[0-9]+" search_in="msg" check_it="true" assign_to="cl0"/>
      <log message="extra ACK at UAS: [$cs0] [$cl0]"/>
    </action>
  </recv>
  <recv request="ACK" optional="true">
    <action>
      <ereg regexp="CSeq: *[0-9]+ ACK" search_in="msg" check_it="true" assign_to="cs1"/>
      <ereg regexp="Content-Length: *[0-9]+" search_in="msg" check_it="true" assign_to="cl1"/>
      <log message="extra ACK at UAS: [$cs1] [$cl1]"/>
    </action>
  </recv>
  <recv request="ACK" optional="true">
    <action>
      <ereg regexp="CSeq: *[0-9]+ ACK" search_in="msg" check_it="true" assign_to="cs2"/>
      <ereg regexp="Content-Length: *[0-9]+" search_in="msg" check_it="true" assign_to="cl2"/>
      <log message="extra ACK at UAS: [$cs2] [$cl2]"/>
    </action>
  </recv>
  <recv request="BYE"/>
  <send>
    <![CDATA[
      SIP/2.0 200 OK
      [last_Via:]
      [last_From:]
      [last_To:]
      [last_Call-ID:]
      [last_CSeq:]
      Content-Length: 0

    ]]>
  </send>
</scenario>
