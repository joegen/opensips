loadmodule "proto_udp.so"
loadmodule "proto_tcp.so"
socket=udp:<KAROO_PRIVATE_IP>:<HOP_PORT> as <KAROO_PUBLIC_IP>:<HOP_PORT>
socket=tcp:<KAROO_PRIVATE_IP>:<HOP_PORT> as <KAROO_PUBLIC_IP>:<HOP_PORT>
modparam("rtpengine", "rtpengine_sock", "udp:127.0.0.1:<NG_PORT>")

route[lo_local_settings] {
  $var(lo_karoo_uri) = "sip:<KAROO_PRIVATE_IP>:5060;transport=tcp";
  $var(lo_karoo_private_ip) = "<KAROO_PRIVATE_IP>";
  $var(lo_karoo_public_ip) = "<KAROO_PUBLIC_IP>";
}
