loadmodule "proto_udp.so"
loadmodule "proto_tcp.so"
socket=udp:192.168.1.19:5080
socket=tcp:192.168.1.19:5080
modparam("rtpengine", "rtpengine_sock", "udp:127.0.0.1:22222")

route[lo_local_settings] {
  $var(lo_karoo_uri) = "sip:192.168.1.19:5060";
  $var(lo_karoo_private_ip) = "192.168.1.19";
  $var(lo_karoo_public_ip) = "127.0.0.3";
}
